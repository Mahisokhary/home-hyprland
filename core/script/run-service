#!/bin/sh

#
# Tries to start a service with systemd
# Fallbacks to normal execution if no service is available or start fails
# Syntax:
# run-service [service name]
# run-service [service name] [fallback command and its arguments ...]
#

if systemctl --user --quiet is-active "$1.service"; then
  exit 0
fi

systemctl --user start "$1.service" 2>/dev/null || {
	if [[ $# -gt 1 ]] then
		shift
		$@
	else
		$1
	fi
}

